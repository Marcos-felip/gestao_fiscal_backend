generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum CompanyType {
  MEI
  ME
  EPP
  LTDA
  SA
  EIRELI
  SLU
}

enum BusinessSegment {
  ALUMINIO_PORTAS
  SUPERMERCADO
  PAPELARIA
  MERCEARIA
  LANCHONETE
  GENERICO
}

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

enum EstablishmentType {
  MATRIZ
  FILIAL
}

enum PartnerType {
  CLIENT
  SUPPLIER
  BOTH
}

enum PersonType {
  PF
  PJ
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SaleStatus {
  ORCAMENTO
  EM_ABERTO
  CONCLUIDA
  CANCELADA
}

enum PaymentStatus {
  PENDENTE
  APROVADO
  RECUSADO
  ESTORNADO
}

enum FiscalStatus {
  NAO_EMITIDO
  PROCESSANDO
  AUTORIZADO
  REJEITADO
  CANCELADO
}

enum PaymentMethod {
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  PIX
  BOLETO
  OUTRO
}

enum PaymentCondition {
  A_VISTA
  A_PRAZO
}

enum FinancialType {
  RECEBER
  PAGAR
}

enum FinancialStatus {
  ABERTO
  PARCIAL
  PAGO
  VENCIDO
  CANCELADO
}

enum CashSessionStatus {
  ABERTA
  FECHADA
}

enum CashMovementType {
  SANGRIA
  SUPRIMENTO
}

enum UnitOfMeasure {
  UN
  KG
  LT
  MT
  CX
  PC
  PCT
  DZ
}

enum FiscalDocumentModel {
  NFE
  NFCE
}

enum FiscalEnvironment {
  HOMOLOGACAO
  PRODUCAO
}

enum FiscalDocumentStatus {
  NAO_EMITIDO
  PENDENTE
  PROCESSANDO
  AUTORIZADO
  REJEITADO
  ERRO
  CONTINGENCIA
  CANCELAMENTO_PENDENTE
  CANCELADO
  INUTILIZADO
}

enum TaxRegimeCode {
  SIMPLES_NACIONAL
  SIMPLES_EXCESSO
  REGIME_NORMAL
}

enum FiscalPaymentCode {
  DINHEIRO
  CHEQUE
  CARTAO_CREDITO
  CARTAO_DEBITO
  CREDITO_LOJA
  VALE_ALIMENTACAO
  VALE_REFEICAO
  VALE_PRESENTE
  VALE_COMBUSTIVEL
  BOLETO
  PIX
  SEM_PAGAMENTO
  OUTRO
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String    @map("password_hash")
  refreshToken        String?   @map("refresh_token")
  companyActiveId     String?   @map("company_active_id")
  forcePasswordChange Boolean   @default(false) @map("force_password_change")
  passwordChangedAt   DateTime? @map("password_changed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  companyActive Company?       @relation("ActiveCompany", fields: [companyActiveId], references: [id])
  memberships   Membership[]
  cashSessions  CashSession[]
  cashMovements CashMovement[]

  @@map("users")
}

model Company {
  id              String           @id @default(uuid())
  name            String
  type            CompanyType?
  businessSegment BusinessSegment? @map("business_segment")
  phone           String?
  cnpj            String?          @unique
  taxRegime       TaxRegime?       @map("tax_regime")
  isOnboarded     Boolean          @default(false) @map("is_onboarded")
  /// Fechamento às cegas: o operador não vê o valor esperado antes de contar
  cashBlindClose  Boolean          @default(false) @map("cash_blind_close")
  /// Razão social da empresa
  razaoSocial     String?          @map("razao_social")
  /// Nome fantasia
  nomeFantasia    String?          @map("nome_fantasia")
  /// Inscrição estadual
  inscricaoEstadual String?        @map("inscricao_estadual")
  /// Inscrição municipal
  inscricaoMunicipal String?       @map("inscricao_municipal")
  /// Código de Regime Tributário (CRT) — usado na emissão fiscal
  crt             TaxRegimeCode?
  /// Empresa é contribuinte do ICMS
  contribuinteIcms Boolean         @default(false) @map("contribuinte_icms")
  /// Configuração fiscal completa para emissão
  fiscalConfigComplete Boolean     @default(false) @map("fiscal_config_complete")
  /// Código IBGE do município da empresa
  codigoIbgeMunicipio String?      @map("codigo_ibge_municipio")
  /// Telefone de contato fiscal
  telefoneFiscal  String?          @map("telefone_fiscal")
  /// E-mail de contato fiscal
  emailFiscal     String?          @map("email_fiscal")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  activeUsers      User[]                  @relation("ActiveCompany")
  memberships      Membership[]
  establishments   Establishment[]
  products         Product[]
  partners         Partner[]
  stockMovements   StockMovement[]
  purchases        Purchase[]
  sales            Sale[]
  salePayments     SalePayment[]
  financialEntries FinancialEntry[]
  rolePermissions  CompanyRolePermission[]
  profiles         PermissionProfile[]
  cashRegisters    CashRegister[]
  cashSessions     CashSession[]
  cashMovements    CashMovement[]
  fiscalSettings   FiscalSettings[]
  fiscalDocuments  FiscalDocument[]
  fiscalCertificateEvents FiscalCertificateEvent[]

  @@map("companies")
}

model Membership {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  companyId String         @map("company_id")
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  deletedAt DateTime?      @map("deleted_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profiles MembershipProfile[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

model Establishment {
  id                 String            @id @default(uuid())
  companyId          String            @map("company_id")
  type               EstablishmentType @default(MATRIZ)
  name               String
  cnpj               String?
  inscricaoEstadual  String?           @map("inscricao_estadual")
  inscricaoMunicipal String?           @map("inscricao_municipal")
  cep                String?
  street             String?
  number             String?
  complement         String?
  neighborhood       String?
  city               String?
  state              String?           @db.Char(2)
  ibgeCode           String?           @map("ibge_code")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases        Purchase[]
  sales            Sale[]
  financialEntries FinancialEntry[]
  cashRegisters    CashRegister[]
  cashSessions     CashSession[]
  fiscalSettings   FiscalSettings?
  fiscalDocuments  FiscalDocument[]

  @@index([companyId])
  @@map("establishments")
}

model Product {
  id                  String        @id @default(uuid())
  companyId           String        @map("company_id")
  name                String
  description         String?
  sku                 String?
  barcode             String?
  unit                UnitOfMeasure @default(UN)
  costPrice           Decimal?      @map("cost_price") @db.Decimal(12, 4)
  salePrice           Decimal?      @map("sale_price") @db.Decimal(12, 4)
  currentStock        Decimal       @default(0) @map("current_stock") @db.Decimal(12, 4)
  minStock            Decimal?      @map("min_stock") @db.Decimal(12, 4)
  isActive            Boolean       @default(true) @map("is_active")
  ncm                 String?
  cest                String?
  cfop                String?
  origin              Int?          @db.SmallInt
  technicalAttributes Json?         @map("technical_attributes")
  /// CSOSN — Código de Situação da Operação para o Simples Nacional
  csosn               String?
  /// CST do ICMS — Código de Situação Tributária (regime normal)
  cstIcms             String?       @map("cst_icms")
  /// CST do PIS
  cstPis              String?       @map("cst_pis")
  /// CST do COFINS
  cstCofins           String?       @map("cst_cofins")
  /// Alíquota de ICMS
  aliquotaIcms        Decimal?      @map("aliquota_icms") @db.Decimal(12, 4)
  /// Alíquota de PIS
  aliquotaPis         Decimal?      @map("aliquota_pis") @db.Decimal(12, 4)
  /// Alíquota de COFINS
  aliquotaCofins      Decimal?      @map("aliquota_cofins") @db.Decimal(12, 4)
  /// Produto com dados fiscais completos para emissão
  fiscalComplete      Boolean       @default(false) @map("fiscal_complete")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@map("products")
}

model Partner {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  type         PartnerType
  personType   PersonType  @map("person_type")
  name         String
  tradeName    String?     @map("trade_name")
  cpfCnpj      String?     @map("cpf_cnpj")
  rgIe         String?     @map("rg_ie")
  email        String?
  phone        String?
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?     @db.Char(2)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchasesAsSupplier Purchase[]
  salesAsCustomer     Sale[]           @relation("SaleCustomer")
  financialEntries    FinancialEntry[]

  @@index([companyId])
  @@index([companyId, type])
  @@map("partners")
}

model StockMovement {
  id          String            @id @default(uuid())
  companyId   String            @map("company_id")
  productId   String            @map("product_id")
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 4)
  reason      String?
  referenceId String?           @map("reference_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  deletedAt   DateTime?         @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@index([companyId, createdAt])
  @@map("stock_movements")
}

model Purchase {
  id               String           @id @default(uuid())
  companyId        String           @map("company_id")
  establishmentId  String           @map("establishment_id")
  supplierId       String?          @map("supplier_id")
  status           PurchaseStatus   @default(DRAFT)
  purchaseNumber   Int              @map("purchase_number")
  totalAmount      Decimal          @default(0) @map("total_amount") @db.Decimal(12, 2)
  paymentCondition PaymentCondition @default(A_VISTA) @map("payment_condition")
  installments     Int              @default(1)
  firstDueDate     DateTime?        @map("first_due_date")
  intervalDays     Int              @default(30) @map("interval_days")
  notes            String?
  purchaseDate     DateTime         @default(now()) @map("purchase_date")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishment    Establishment    @relation(fields: [establishmentId], references: [id])
  supplier         Partner?         @relation(fields: [supplierId], references: [id])
  items            PurchaseItem[]
  financialEntries FinancialEntry[]

  @@unique([companyId, purchaseNumber])
  @@index([companyId])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String  @map("purchase_id")
  productId  String  @map("product_id")
  quantity   Decimal @db.Decimal(12, 4)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 4)
  total      Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@map("purchase_items")
}

model Sale {
  id               String           @id @default(uuid())
  companyId        String           @map("company_id")
  establishmentId  String           @map("establishment_id")
  customerId       String?          @map("customer_id")
  status           SaleStatus       @default(ORCAMENTO)
  paymentStatus    PaymentStatus    @default(PENDENTE) @map("payment_status")
  fiscalStatus     FiscalStatus     @default(NAO_EMITIDO) @map("fiscal_status")
  saleNumber       Int              @map("sale_number")
  subtotal         Decimal          @db.Decimal(12, 2)
  discount         Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal          @map("total_amount") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod?   @map("payment_method")
  paymentCondition PaymentCondition @default(A_VISTA) @map("payment_condition")
  installments     Int              @default(1)
  firstDueDate     DateTime?        @map("first_due_date")
  intervalDays     Int              @default(30) @map("interval_days")
  /// Sessão de caixa que registrou a venda à vista; nulo em orçamento e a prazo
  cashSessionId    String?          @map("cash_session_id")
  notes            String?
  saleDate         DateTime         @default(now()) @map("sale_date")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishment    Establishment    @relation(fields: [establishmentId], references: [id])
  customer         Partner?         @relation("SaleCustomer", fields: [customerId], references: [id])
  cashSession      CashSession?     @relation(fields: [cashSessionId], references: [id])
  items            SaleItem[]
  payments         SalePayment[]
  financialEntries FinancialEntry[]
  fiscalDocument   FiscalDocument?

  @@unique([companyId, saleNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, saleDate])
  @@index([cashSessionId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String  @map("sale_id")
  productId String  @map("product_id")
  quantity  Decimal @db.Decimal(12, 4)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 4)
  total     Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

/// Formas de pagamento de uma venda à vista. Várias linhas por venda:
/// o balcão aceita pagamento dividido (parte no PIX, parte em dinheiro).
model SalePayment {
  id             String        @id @default(uuid())
  companyId      String        @map("company_id")
  saleId         String        @map("sale_id")
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  amountReceived Decimal?      @map("amount_received") @db.Decimal(12, 2)
  changeGiven    Decimal?      @map("change_given") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([companyId])
  @@map("sale_payments")
}

/// Terminal físico de venda. O caixa é cadastrado uma vez e reaberto todo dia
/// por uma nova sessão.
model CashRegister {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  establishmentId String    @map("establishment_id")
  name            String
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id])
  sessions      CashSession[]

  @@unique([companyId, establishmentId, name])
  @@index([companyId])
  @@map("cash_registers")
}

/// Turno de um operador em um terminal: abre com o fundo de troco, recebe as
/// vendas em dinheiro e fecha com a conferência da gaveta.
model CashSession {
  id              String            @id @default(uuid())
  companyId       String            @map("company_id")
  establishmentId String            @map("establishment_id")
  cashRegisterId  String            @map("cash_register_id")
  operatorId      String            @map("operator_id")
  status          CashSessionStatus @default(ABERTA)
  openingAmount   Decimal           @map("opening_amount") @db.Decimal(12, 2)
  openedAt        DateTime          @default(now()) @map("opened_at")
  closedAt        DateTime?         @map("closed_at")
  expectedCash    Decimal?          @map("expected_cash") @db.Decimal(12, 2)
  countedCash     Decimal?          @map("counted_cash") @db.Decimal(12, 2)
  difference      Decimal?          @db.Decimal(12, 2)
  closingNotes    String?           @map("closing_notes")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishment Establishment  @relation(fields: [establishmentId], references: [id])
  cashRegister  CashRegister   @relation(fields: [cashRegisterId], references: [id])
  operator      User           @relation(fields: [operatorId], references: [id])
  movements     CashMovement[]
  sales         Sale[]

  @@index([companyId, status])
  @@index([cashRegisterId, status])
  @@index([operatorId, status])
  @@map("cash_sessions")
}

/// Dinheiro que entra ou sai da gaveta fora da venda: sangria e suprimento.
model CashMovement {
  id          String           @id @default(uuid())
  companyId   String           @map("company_id")
  sessionId   String           @map("session_id")
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  reason      String?
  createdById String           @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session   CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User        @relation(fields: [createdById], references: [id])

  @@index([sessionId])
  @@index([companyId])
  @@map("cash_movements")
}

model FinancialEntry {
  id                String          @id @default(uuid())
  companyId         String          @map("company_id")
  establishmentId   String?         @map("establishment_id")
  type              FinancialType
  status            FinancialStatus @default(ABERTO)
  partnerId         String?         @map("partner_id")
  saleId            String?         @map("sale_id")
  purchaseId        String?         @map("purchase_id")
  category          String?
  description       String
  amount            Decimal         @db.Decimal(12, 2)
  paidAmount        Decimal         @default(0) @map("paid_amount") @db.Decimal(12, 2)
  issueDate         DateTime        @default(now()) @map("issue_date")
  dueDate           DateTime        @map("due_date")
  installmentNumber Int             @default(1) @map("installment_number")
  installmentTotal  Int             @default(1) @map("installment_total")
  paymentMethod     PaymentMethod?  @map("payment_method")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishment Establishment?     @relation(fields: [establishmentId], references: [id])
  partner       Partner?           @relation(fields: [partnerId], references: [id])
  sale          Sale?              @relation(fields: [saleId], references: [id])
  purchase      Purchase?          @relation(fields: [purchaseId], references: [id])
  payments      FinancialPayment[]

  @@index([companyId, type, status])
  @@index([companyId, dueDate])
  @@map("financial_entries")
}

model FinancialPayment {
  id        String         @id @default(uuid())
  entryId   String         @map("entry_id")
  amount    Decimal        @db.Decimal(12, 2)
  paidAt    DateTime       @default(now()) @map("paid_at")
  method    PaymentMethod?
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")

  entry FinancialEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("financial_payments")
}

model Permission {
  code        String @id
  description String

  rolePermissions        RolePermission[]
  companyRolePermissions CompanyRolePermission[]
  profilePermissions     PermissionProfilePermission[]

  @@map("permissions")
}

model RolePermission {
  role           MembershipRole @map("role")
  permissionCode String         @map("permission_code")

  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([role, permissionCode])
  @@map("role_permissions")
}

model CompanyRolePermission {
  companyId      String         @map("company_id")
  role           MembershipRole @map("role")
  permissionCode String         @map("permission_code")

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([companyId, role, permissionCode])
  @@index([companyId, role])
  @@map("company_role_permissions")
}

model PermissionProfile {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions PermissionProfilePermission[]
  memberships MembershipProfile[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("permission_profiles")
}

model PermissionProfilePermission {
  profileId      String @map("profile_id")
  permissionCode String @map("permission_code")

  profile    PermissionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permission Permission        @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([profileId, permissionCode])
  @@index([permissionCode])
  @@map("permission_profile_permissions")
}

model MembershipProfile {
  membershipId String @map("membership_id")
  profileId    String @map("profile_id")

  membership Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  profile    PermissionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([membershipId, profileId])
  @@index([profileId])
  @@map("membership_profiles")
}

/// Configuração fiscal por estabelecimento: série, numeração, certificado e CSC.
model FiscalSettings {
  id               String            @id @default(uuid())
  establishmentId  String            @map("establishment_id")
  establishment    Establishment     @relation(fields: [establishmentId], references: [id])
  companyId        String            @map("company_id")
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ambiente         FiscalEnvironment @default(HOMOLOGACAO)
  serieNfce        Int               @default(1) @map("serie_nfce")
  proximoNumeroNfce Int              @default(1) @map("proximo_numero_nfce")
  codigoCsc        String?           @map("codigo_csc")
  idCsc            String?           @map("id_csc")
  /// Referência criptografada ao certificado A1 no cofre (KMS/Vault)
  certificadoRef   String?           @map("certificado_ref")
  /// Referência criptografada à senha do certificado
  certificadoSenhaRef String?        @map("certificado_senha_ref")
  /// Validade do certificado digital
  certificadoValidade DateTime?      @map("certificado_validade")
  /// Subject DN do certificado digital
  certificadoSubject String?         @map("certificado_subject")
  ativo            Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  certificateEvents FiscalCertificateEvent[]

  @@unique([establishmentId])
  @@index([companyId])
  @@map("fiscal_settings")
}

/// Auditoria de envio e substituição do certificado A1 de um estabelecimento.
model FiscalCertificateEvent {
  id               String         @id @default(uuid())
  companyId        String         @map("company_id")
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalSettingsId String         @map("fiscal_settings_id")
  fiscalSettings   FiscalSettings @relation(fields: [fiscalSettingsId], references: [id], onDelete: Cascade)
  /// Tipo do evento: "upload" ou "substituicao"
  tipo             String
  /// Subject DN do certificado enviado
  subject          String?
  /// Common Name do titular
  titular          String?
  /// Validade final do certificado enviado
  validoAte        DateTime?      @map("valido_ate")
  /// Subject DN do certificado que estava configurado antes da substituição
  subjectAnterior  String?        @map("subject_anterior")
  usuarioId        String?        @map("usuario_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([companyId])
  @@index([fiscalSettingsId])
  @@map("fiscal_certificate_events")
}

/// Documento fiscal emitido (NF-e ou NFC-e): um por venda, com status, XML e histórico.
model FiscalDocument {
  id               String               @id @default(uuid())
  companyId        String               @map("company_id")
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishmentId  String               @map("establishment_id")
  establishment    Establishment        @relation(fields: [establishmentId], references: [id])
  saleId           String?              @unique @map("sale_id")
  sale             Sale?                @relation(fields: [saleId], references: [id])
  modelo           FiscalDocumentModel
  serie            Int
  numero           Int
  chaveAcesso      String?              @unique @map("chave_acesso")
  ambiente         FiscalEnvironment
  status           FiscalDocumentStatus @default(PENDENTE)
  protocolo        String?
  rejeicaoCodigo   String?              @map("rejeicao_codigo")
  rejeicaoMensagem String?              @map("rejeicao_mensagem")
  dataEmissao      DateTime?            @map("data_emissao")
  dataAutorizacao  DateTime?            @map("data_autorizacao")
  dataCancelamento DateTime?            @map("data_cancelamento")
  valorTotal       Decimal?             @map("valor_total") @db.Decimal(15, 2)
  /// XML enviado (base64 ou referência S3)
  xmlEnviado       String?              @map("xml_enviado")
  /// XML autorizado pela SEFAZ (base64 ou referência S3)
  xmlAutorizado    String?              @map("xml_autorizado")
  /// XML de cancelamento (base64 ou referência S3)
  xmlCancelamento  String?              @map("xml_cancelamento")
  /// URL do DANFE no storage (S3)
  danfeUrl         String?              @map("danfe_url")
  /// QR Code da NFC-e
  qrCode           String?              @map("qr_code")
  /// Chave de idempotência para evitar emissão duplicada
  idempotencyKey   String?              @unique @map("idempotency_key")
  /// Tentativas de emissão
  attempts         Int                  @default(0)
  /// Motor de emissão: "dfe-net" ou futuro
  engine           String?
  /// Snapshot imutável dos dados no momento da emissão (JSONB)
  snapshot         Json?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")

  statusHistory FiscalStatusHistory[]
  events        FiscalDocumentEvent[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([saleId])
  @@map("fiscal_documents")
}

/// Histórico de transições de status de um documento fiscal.
model FiscalStatusHistory {
  id               String               @id @default(uuid())
  fiscalDocumentId String               @map("fiscal_document_id")
  fiscalDocument   FiscalDocument       @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)
  statusFrom       FiscalDocumentStatus @map("status_from")
  statusTo         FiscalDocumentStatus @map("status_to")
  motivo           String?
  usuarioId        String?              @map("usuario_id")
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([fiscalDocumentId])
  @@map("fiscal_status_history")
}

/// Eventos auditáveis de um documento fiscal (emissão, cancelamento, download, etc.).
model FiscalDocumentEvent {
  id               String         @id @default(uuid())
  fiscalDocumentId String         @map("fiscal_document_id")
  fiscalDocument   FiscalDocument @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)
  /// Tipo do evento: "emissao", "cancelamento", "consulta", "retry", "download_xml", "download_danfe", "reimpressao"
  tipo             String
  detalhes         Json?
  usuarioId        String?        @map("usuario_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([fiscalDocumentId])
  @@map("fiscal_document_events")
}
