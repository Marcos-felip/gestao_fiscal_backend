generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum CompanyType {
  MEI
  ME
  EPP
  LTDA
  SA
  EIRELI
  SLU
}

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

enum EstablishmentType {
  MATRIZ
  FILIAL
}

enum PartnerType {
  CLIENT
  SUPPLIER
  BOTH
}

enum PersonType {
  PF
  PJ
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum UnitOfMeasure {
  UN
  KG
  LT
  MT
  CX
  PC
  PCT
  DZ
}

// ─── USER ───────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String    @map("password_hash")
  refreshToken    String?   @map("refresh_token")
  companyActiveId String?   @map("company_active_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  companyActive Company?     @relation("ActiveCompany", fields: [companyActiveId], references: [id])
  memberships   Membership[]

  @@map("users")
}

// ─── COMPANY (TENANT) ───────────────────────────────────

model Company {
  id          String       @id @default(uuid())
  name        String
  type        CompanyType?
  phone       String?
  cnpj        String?      @unique
  taxRegime   TaxRegime?   @map("tax_regime")
  isOnboarded Boolean      @default(false) @map("is_onboarded")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  activeUsers    User[]          @relation("ActiveCompany")
  memberships    Membership[]
  establishments Establishment[]
  products       Product[]
  partners       Partner[]
  stockMovements StockMovement[]
  sales          Sale[]
  purchases      Purchase[]

  @@map("companies")
}

// ─── MEMBERSHIP ─────────────────────────────────────────

model Membership {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  companyId String         @map("company_id")
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  deletedAt DateTime?      @map("deleted_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

// ─── ESTABLISHMENT ──────────────────────────────────────

model Establishment {
  id                 String            @id @default(uuid())
  companyId          String            @map("company_id")
  type               EstablishmentType @default(MATRIZ)
  name               String
  cnpj               String?
  inscricaoEstadual  String?           @map("inscricao_estadual")
  inscricaoMunicipal String?           @map("inscricao_municipal")
  cep                String?
  street             String?
  number             String?
  complement         String?
  neighborhood       String?
  city               String?
  state              String?           @db.Char(2)
  ibgeCode           String?           @map("ibge_code")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales     Sale[]
  purchases Purchase[]

  @@index([companyId])
  @@map("establishments")
}

// ─── PRODUCT ────────────────────────────────────────────

model Product {
  id           String        @id @default(uuid())
  companyId    String        @map("company_id")
  name         String
  description  String?
  sku          String?
  barcode      String?
  unit         UnitOfMeasure @default(UN)
  costPrice    Decimal?      @map("cost_price") @db.Decimal(12, 4)
  salePrice    Decimal?      @map("sale_price") @db.Decimal(12, 4)
  currentStock Decimal       @default(0) @map("current_stock") @db.Decimal(12, 4)
  minStock     Decimal?      @map("min_stock") @db.Decimal(12, 4)
  isActive     Boolean       @default(true) @map("is_active")
  ncm          String?
  cest         String?
  cfop         String?
  origin       Int?          @db.SmallInt
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@map("products")
}

// ─── PARTNER ────────────────────────────────────────────

model Partner {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  type         PartnerType
  personType   PersonType  @map("person_type")
  name         String
  tradeName    String?     @map("trade_name")
  cpfCnpj      String?     @map("cpf_cnpj")
  rgIe         String?     @map("rg_ie")
  email        String?
  phone        String?
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?     @db.Char(2)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  company             Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesAsClient       Sale[]
  purchasesAsSupplier Purchase[]

  @@index([companyId])
  @@index([companyId, type])
  @@map("partners")
}

// ─── STOCK MOVEMENT ─────────────────────────────────────

model StockMovement {
  id          String            @id @default(uuid())
  companyId   String            @map("company_id")
  productId   String            @map("product_id")
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 4)
  reason      String?
  referenceId String?           @map("reference_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  deletedAt   DateTime?         @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@index([companyId, createdAt])
  @@map("stock_movements")
}

// ─── SALE ───────────────────────────────────────────────

model Sale {
  id              String     @id @default(uuid())
  companyId       String     @map("company_id")
  establishmentId String     @map("establishment_id")
  clientId        String?    @map("client_id")
  status          SaleStatus @default(DRAFT)
  saleNumber      Int        @map("sale_number")
  totalAmount     Decimal    @default(0) @map("total_amount") @db.Decimal(12, 2)
  discount        Decimal    @default(0) @db.Decimal(12, 2)
  notes           String?
  saleDate        DateTime   @default(now()) @map("sale_date")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id])
  client        Partner?      @relation(fields: [clientId], references: [id])
  items         SaleItem[]

  @@unique([companyId, saleNumber])
  @@index([companyId])
  @@index([companyId, saleDate])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String  @map("sale_id")
  productId String  @map("product_id")
  quantity  Decimal @db.Decimal(12, 4)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 4)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

// ─── PURCHASE ───────────────────────────────────────────

model Purchase {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  establishmentId String         @map("establishment_id")
  supplierId      String?        @map("supplier_id")
  status          PurchaseStatus @default(DRAFT)
  purchaseNumber  Int            @map("purchase_number")
  totalAmount     Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes           String?
  purchaseDate    DateTime       @default(now()) @map("purchase_date")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishment Establishment  @relation(fields: [establishmentId], references: [id])
  supplier      Partner?       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]

  @@unique([companyId, purchaseNumber])
  @@index([companyId])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String  @map("purchase_id")
  productId  String  @map("product_id")
  quantity   Decimal @db.Decimal(12, 4)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 4)
  total      Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@map("purchase_items")
}
