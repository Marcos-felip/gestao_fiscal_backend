POSTGRES_HOST_PORT=5433
PGADMIN_HOST_PORT=5050
REDIS_HOST_PORT=6379
FISCAL_ENGINE_HOST_PORT=8080

DATABASE_URL="postgresql://gestao_fiscal:gestao_fiscal_dev@127.0.0.1:5433/gestao_fiscal?schema=public"
JWT_SECRET="super-secret-key-change-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
PORT=3000

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Fiscal Engine (fiscal_service .NET / DFe.NET)
FISCAL_ENGINE_URL=http://localhost:8080
FISCAL_ENGINE_API_KEY=
FISCAL_ENGINE_TIMEOUT=30000
FISCAL_ENGINE_HEALTH_TIMEOUT=5000

# Só para `docker compose --profile fiscal up -d`: caminho do repositório do
# motor .NET a ser construído e ambiente do ASP.NET (Development expõe o Swagger).
FISCAL_SERVICE_PATH=../fiscal_service
FISCAL_SERVICE_ENV=Development

# Cofre do certificado A1 — 32 bytes em base64 ou hexadecimal.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FISCAL_CERT_ENCRYPTION_KEY=

# S3 Storage (Supabase Storage compatível)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=fiscal-documents

FRONTEND_COPILOT_INSTRUCTIONS_PATH="/home/marcos/Projetos/gestao_fiscal_frontend/.github/copilot-instructions.md"
